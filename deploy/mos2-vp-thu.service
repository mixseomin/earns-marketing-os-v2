[Unit]
Description=Van phong pixel RIENG cua MOI phong (apps/cty/cong-ty/phong) + bo dieu phoi :3863 — ten unit giu tu Phong thu vi deploy.sh cai theo ten tep
After=network.target mos2-cty.service
[Service]
Type=simple
User=root
WorkingDirectory=/opt/earns-marketing-os-v2/apps/cty
Environment=NODE_ENV=production
# Trình chạy dựng một pixel-agents cho MỖI phòng (HOME riêng /var/lib/cty/vp-<phòng>, cổng tự xin) rồi bơm nhân sự phòng đó, và giữ bộ điều phối
# :3863 nginx đưa /vp/<phòng>/ về; con chết → cả nhóm dừng, systemd dựng lại. Phòng mới (tệp hồ sơ phòng mới) → tự mở văn phòng trong ≤ 1 phút.
ExecStart=/usr/bin/node /opt/earns-marketing-os-v2/apps/cty/scripts/seed-van-phong.mjs --cac-phong
Restart=always
RestartSec=3
[Install]
WantedBy=multi-user.target
