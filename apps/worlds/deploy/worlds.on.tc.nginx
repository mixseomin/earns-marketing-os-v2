# worlds.on.tc — Sổ Thế Giới: nhiều thế giới hư cấu theo chuẩn OnlyWorlds (apps/worlds/public, tệp tĩnh, dữ liệu the-gioi/*.json). Anh 23/11/2026.
# SSO mos2 như mọi sub mới (khuôn sprawl.on.tc). deploy.sh khối 5e7 cài tệp này; DNS do deploy/dns-on-tc.sh tự tạo.
# /chung/ = thư mục castle (hòm góp ý gopy.js) dùng chung, không chép mã.
server { listen 80; server_name worlds.on.tc; return 301 https://$host$request_uri; }
server {
  listen 443 ssl; http2 on;
  server_name worlds.on.tc;
  include snippets/cloudflare-allow.conf;
  ssl_certificate /etc/letsencrypt/live/on.tc/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/on.tc/privkey.pem;
  root /opt/earns-marketing-os-v2/apps/worlds/public;
  add_header X-Robots-Tag "noindex, nofollow" always;
  gzip on; gzip_types text/css application/javascript image/svg+xml application/json; gzip_min_length 1024;
  auth_request /_mos2auth;
  error_page 401 = @login;
  location = /_mos2auth { internal; proxy_pass http://127.0.0.1:3821/api/auth/verify; proxy_pass_request_body off; proxy_set_header Content-Length ""; proxy_set_header Cookie $http_cookie; proxy_set_header Host mos2.on.tc; }
  location @login { return 302 https://mos2.on.tc/login?next=https://worlds.on.tc$request_uri; }
  location = /robots.txt { auth_request off; default_type text/plain; return 200 "User-agent: *\nDisallow: /\n"; }
  location = /api/gop-y { client_max_body_size 8m; proxy_pass http://127.0.0.1:3821/api/gop-y-ngoai; proxy_http_version 1.1; proxy_set_header Host mos2.on.tc; proxy_set_header Cookie $http_cookie; proxy_set_header X-Forwarded-Proto https; proxy_read_timeout 60s; }
  location ^~ /chung/ { alias /opt/earns-marketing-os-v2/apps/castle/public/; add_header Cache-Control "no-cache"; add_header X-Robots-Tag "noindex, nofollow" always; types { application/javascript js; } }
  include snippets/worlds-ban.conf;
  location / { add_header Cache-Control "no-cache"; add_header X-Robots-Tag "noindex, nofollow" always; sub_filter '__BAN__' $worlds_ban; sub_filter_once off; try_files $uri /index.html; }
}
