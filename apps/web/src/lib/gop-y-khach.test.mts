import assert from 'node:assert';
import { hostTrangNhung, laTrangKhach, maKhachHopLe, nguoiKhach, nuocDuocKhach } from './gop-y-khach';
const MA = '0f8fad5b-d9cb-469f-a165-70867728950e';
assert.equal(laTrangKhach('dantranh.on.tc'), true);
assert.equal(laTrangKhach('DanTranh2.on.tc:443'), true);
assert.equal(laTrangKhach('castle.on.tc'), false);
assert.equal(laTrangKhach(''), false);
assert.equal(nuocDuocKhach('vn'), true);
assert.equal(nuocDuocKhach('US'), false);
assert.equal(nuocDuocKhach(null), false);
assert.equal(hostTrangNhung('https://mos2.on.tc/nhung/gop-y?trang=' + encodeURIComponent('https://dantranh.on.tc/a')), 'dantranh.on.tc');
assert.equal(hostTrangNhung('https://mos2.on.tc/khac?trang=' + encodeURIComponent('https://dantranh.on.tc/a')), '');
assert.equal(hostTrangNhung('rác'), '');
assert.equal(maKhachHopLe(MA), true);
assert.equal(maKhachHopLe("x' OR 1=1 --"), false);
assert.deepEqual(nguoiKhach(MA, 'dantranh.on.tc'), { email: 'khach:' + MA, displayName: 'Khách dantranh · 0f8f', role: 'khach' });
assert.equal(nguoiKhach(MA, 'castle.on.tc'), null);
assert.equal(nguoiKhach('sai', 'dantranh.on.tc'), null);
console.log('gop-y-khach: đạt');
