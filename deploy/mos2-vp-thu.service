[Unit]
Description=Van phong pixel RIENG cua cac phong (moi phong khai van_phong_cong trong apps/cty/cong-ty/phong) — ten unit giu tu Phong thu vi deploy.sh cai theo ten tep
After=network.target mos2-cty.service
[Service]
Type=simple
User=root
WorkingDirectory=/opt/earns-marketing-os-v2/apps/cty
Environment=NODE_ENV=production
# Trình chạy dựng một pixel-agents cho mỗi phòng (HOME riêng /var/lib/cty/vp-<phòng>, cổng riêng) rồi bơm nhân sự phòng đó; con chết → cả nhóm
# dừng, systemd dựng lại. Thêm phòng = dòng van_phong_cong ở hồ sơ phòng + dòng map ở deploy/nginx-cty.conf (worker/vp.mjs --tu-kiem đối chiếu).
ExecStart=/usr/bin/node /opt/earns-marketing-os-v2/apps/cty/scripts/seed-van-phong.mjs --cac-phong
Restart=always
RestartSec=3
[Install]
WantedBy=multi-user.target
