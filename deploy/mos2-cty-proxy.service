[Unit]
Description=Cong ty AI — proxy da mo hinh (apps/cty/worker/proxy.mjs, port 3862)
After=network.target
[Service]
Type=simple
User=root
WorkingDirectory=/opt/earns-marketing-os-v2/apps/cty
EnvironmentFile=/opt/earns-marketing-os-v2/.env.production
Environment=NODE_ENV=production
Environment=PORT=3862
ExecStart=/usr/bin/node worker/proxy.mjs
Restart=always
RestartSec=3
[Install]
WantedBy=multi-user.target
