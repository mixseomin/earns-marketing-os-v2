[Unit]
Description=ETP2 (apps/etp2, port 3880) — etp2.on.tc, bản etp riêng của anh
After=network.target
[Service]
Type=simple
User=root
WorkingDirectory=/opt/earns-marketing-os-v2/apps/etp2
EnvironmentFile=/opt/earns-marketing-os-v2/.env.production
Environment=NODE_ENV=production
Environment=PORT=3880
# pool Postgres riêng của etp2 (packages/db/src/client.ts đọc biến này): docEtp chạy ~30 câu song song, 4 kết nối làm câu xếp hàng (26/11/2026)
Environment=DB_POOL_MAX=12
ExecStart=/usr/bin/npm run start
Restart=always
RestartSec=3
[Install]
WantedBy=multi-user.target
